{
  "name": "hz-9-tool",
  "private": true,
  "scripts": {
    "nx": "nx",
    "build": "nx run-many --target=build --all",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "api-report": "nx run-many --target=api-report --all",
    "format": "prettier --write \"**/*.{js,ts,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,css,md}\"",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "bash ./scripts/release.sh"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.2.2",
    "@commitlint/config-conventional": "^19.2.2",
    "@hz-9/eslint-config-airbnb-ts": "0.11.0",
    "@hz-9/prettier-config": "^0.3.1",
    "@microsoft/api-documenter": "^7.30.5",
    "@microsoft/api-extractor": "^7.42.3",
    "@nx/eslint": "19.0.0",
    "@nx/vite": "19.0.0",
    "@types/node": "~20.3.1",
    "eslint": "^8.2.0",
    "husky": "^9.0.11",
    "nx": "19.0.0",
    "prettier": "^3.2.5",
    "pretty-quick": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.15.0 <19.0.0 || >=20.9.0 <21.0.0"
  },
  "packageManager": "pnpm@8.15.9"
}
