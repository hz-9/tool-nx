{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (algorithm)",
      "cwd": "${workspaceFolder}/packages/algorithm",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--config", "${workspaceFolder}/packages/algorithm/vite.config.ts"],
      "console": "integratedTerminal",
      "sourceMaps": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest (docs-build)",
      "cwd": "${workspaceFolder}/packages/docs-build",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--config", "${workspaceFolder}/packages/docs-build/vite.config.ts"],
      "console": "integratedTerminal",
      "sourceMaps": true
    }
  ]
}
