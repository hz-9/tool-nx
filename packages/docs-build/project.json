{
  "name": "@hz-9/docs-build",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "{projectRoot}/lib",
        "generatePackageJson": false,
        "cwd": "{projectRoot}",
        "skipTypeCheck": true
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run || true",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.ts", "{projectRoot}/*.{js,cjs,mjs,ts,cts,mts}"],
        "cache": true,
        "cacheLocation": "{projectRoot}/.cache/eslint"
      }
    },
    "api-report": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "api-extractor run --local",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["scope:library"]
}
